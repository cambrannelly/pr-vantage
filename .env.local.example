# GitHub: optional. By default the app offers every account you are logged into
# with `gh auth login` and lets you switch between them in the sidebar.
# Set a token instead (or in addition) if you do not use gh.
# Fine-grained PAT needs: Pull requests (read/write), Contents (read), Metadata (read).
GITHUB_TOKEN=

# Model provider, API key, model, and effort are set on the Settings page inside the app
# (stored in data/settings.json, gitignored). Nothing model-related goes in this file.

# Optional: seed the sidebar with repos, comma separated owner/name.
PR_VANTAGE_REPOS=

# Optional: background pre-warm. While the app runs it polls pinned repos and
# generates summaries for fresh PR heads so pages open instantly.
# PR_VANTAGE_PREWARM=off             disable
# PR_VANTAGE_PREWARM_INTERVAL=90     seconds between polls
# PR_VANTAGE_PREWARM_DAYS=7          only PRs updated within this many days
# PR_VANTAGE_PREWARM_CONCURRENCY=1   parallel generations
