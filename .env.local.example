# GitHub: optional. By default the app offers every account you are logged into
# with `gh auth login` and lets you switch between them in the sidebar.
# Set a token instead (or in addition) if you do not use gh.
# Fine-grained PAT needs: Pull requests (read/write), Contents (read), Metadata (read).
GITHUB_TOKEN=

# Model provider: set ONE API key. The first one found is used unless PR_VANTAGE_PROVIDER says otherwise.
# Subscriptions (Claude Max, ChatGPT Plus) cannot be used; every provider issues API keys.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# KIMI_API_KEY=                       # Moonshot / Kimi, https://platform.kimi.ai
# Any other OpenAI-compatible endpoint (DeepSeek, Groq, OpenRouter, Ollama, Gemini compat URL):
# PR_VANTAGE_PROVIDER=custom
# PR_VANTAGE_LLM_BASE_URL=https://api.deepseek.com/v1
# PR_VANTAGE_LLM_API_KEY=
# PR_VANTAGE_MODEL=deepseek-reasoner

# Optional: pick the provider explicitly (anthropic | openai | kimi | custom) and override its default model
# (claude-opus-5, gpt-6-astra, kimi-k3). Effort is low | medium | high; lower is faster and cheaper.
# PR_VANTAGE_PROVIDER=anthropic
# PR_VANTAGE_MODEL=claude-opus-5
# PR_VANTAGE_EFFORT=medium

# Optional: seed the sidebar with repos, comma separated owner/name.
PR_VANTAGE_REPOS=

# Optional: background pre-warm. While the app runs it polls pinned repos and
# generates summaries for fresh PR heads so pages open instantly.
# PR_VANTAGE_PREWARM=off             disable
# PR_VANTAGE_PREWARM_INTERVAL=90     seconds between polls
# PR_VANTAGE_PREWARM_DAYS=7          only PRs updated within this many days
# PR_VANTAGE_PREWARM_CONCURRENCY=1   parallel generations
